{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/check-auctions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-shipping-deadlines",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/process-escrow-completions",
      "schedule": "0 4 * * *"
    }
  ]
}
